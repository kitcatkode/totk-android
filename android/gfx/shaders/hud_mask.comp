#version 450
// Frame generation with the HUD apart (vk_draw.c): where the frame's final picture differs from its scene (the HUD was
// drawn there), the generated picture takes the final pixel; elsewhere it keeps the interpolated scene.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D scene_img;
layout(set = 0, binding = 1, rgba8) uniform readonly image2D final_img;
layout(set = 0, binding = 2, rgba8) uniform image2D gen_img;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(gen_img)))) return;
    vec4 f = imageLoad(final_img, p);
    if (any(notEqual(imageLoad(scene_img, p), f))) imageStore(gen_img, p, f);
}
